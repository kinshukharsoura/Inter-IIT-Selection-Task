# ---------------------------------------------------------------------------
# Recipe Composition & Management System — environment variables
# Copy to .env (`cp .env.example .env`) and replace the placeholder secrets.
# .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- PostgreSQL (used by docker compose) -----------------------------------
POSTGRES_USER=recipes
# REQUIRED. Use a URL-safe value (letters, digits, - _ .) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=recipes
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
# Connection string. docker compose builds it from the POSTGRES_* values above;
# set it explicitly when running the backend without Docker.
DATABASE_URL=postgresql://recipes:change-me-postgres-password@localhost:5432/recipes?schema=public
# Separate database for the integration tests (all tables are truncated). Must contain "test".
TEST_DATABASE_URL=postgresql://recipes:change-me-postgres-password@localhost:5432/recipes_test?schema=public
# REQUIRED. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Token lifetime (jsonwebtoken format: 15m, 12h, 1d, ...).
JWT_EXPIRES_IN=1d
# API port.
PORT=4000
# Allowed browser origin(s) for CORS, comma separated.
FRONTEND_URL=http://localhost:5173
# bcrypt cost factor (10–12 recommended).
BCRYPT_SALT_ROUNDS=12
NODE_ENV=development

# --- Seed data -------------------------------------------------------------
# docker compose runs the seed on start-up when true. It imports the dataset only once
# (when the demo user has no imported recipes), so later edits are kept across restarts.
RUN_SEED=true
# Re-import / re-sync the dataset even if it was already imported (overwrites dataset recipes).
# SEED_FORCE=false
# Public demo credentials created by the seed (not secrets).
SEED_DEMO_EMAIL=demo@recipes.local
SEED_DEMO_PASSWORD=Demo@12345

# --- Ports published by docker compose ---------------------------------------
FRONTEND_PORT=8080

# --- Frontend (build time, only needed when the API is on another origin) -----
# VITE_API_URL=https://your-api.example.com/api
